<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>SimpleInjector adapter for FlexPipe. Provides extension methods to register and resolve FlexPipe pipelines using the SimpleInjector DI container.</Description>
    <PackageTags>pipeline;middleware;simpleinjector;dependency-injection;extensions;dotnet;netstandard</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SimpleInjector" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlexPipe\FlexPipe.csproj" />
  </ItemGroup>

</Project>
