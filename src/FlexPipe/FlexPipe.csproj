<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlexPipe.SourceGeneration\FlexPipe.SourceGeneration.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="AddAnalyzersToPack" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="..\FlexPipe.SourceGeneration\bin\$(Configuration)\netstandard2.0\FlexPipe.SourceGeneration.dll"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />
    </ItemGroup>
  </Target>
</Project>
